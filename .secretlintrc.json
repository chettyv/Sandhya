{
  "$schema": "https://json.schemastore.org/secretlintrc.json",
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-preset-recommend"
    },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "Supabase publishable key",
            "pattern": "/sb_publishable_[A-Za-z0-9_-]{20,}/g"
          },
          {
            "name": "Supabase secret key",
            "pattern": "/sb_secret_[A-Za-z0-9_-]{20,}/g"
          },
          {
            "name": "Supabase JWT (legacy anon / service_role)",
            "pattern": "/eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9\\.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+/g"
          },
          {
            "name": "Anthropic API key",
            "pattern": "/sk-ant-[A-Za-z0-9_-]{20,}/g"
          },
          {
            "name": "OpenAI API key (project)",
            "pattern": "/sk-proj-[A-Za-z0-9_-]{20,}/g"
          },
          {
            "name": "OpenAI API key (legacy)",
            "pattern": "/sk-[A-Za-z0-9]{40,}/g"
          },
          {
            "name": "RevenueCat secret key",
            "pattern": "/sk_[A-Za-z0-9]{30,}/g"
          },
          {
            "name": "Google API key",
            "pattern": "/AIza[0-9A-Za-z_-]{35}/g"
          }
        ]
      }
    }
  ],
  "rulesPreset": []
}
