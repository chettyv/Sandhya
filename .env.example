# =============================================================================
# Sandhya — environment variables
# =============================================================================
# Copy this file to `.env` (gitignored) and fill in real values for local dev.
# In CI and production, set these in the corresponding secret manager:
#   - GitHub Actions secrets (CI)
#   - Supabase Edge Function env (server-side runtime)
#   - EAS Secrets (mobile build-time public vars)
#
# Rule of thumb:
#   * Variables WITHOUT the `EXPO_PUBLIC_` prefix are SERVER-ONLY.
#     They MUST NEVER be referenced from `apps/mobile`. Doing so leaks them
#     into the app bundle.
#   * Variables WITH the `EXPO_PUBLIC_` prefix are bundled into the mobile
#     app and are visible to anyone with the binary. Only put truly public
#     keys here (Supabase anon key, RevenueCat public SDK keys, PostHog write
#     key, Sentry DSN).
# =============================================================================


# -----------------------------------------------------------------------------
# Backend / scripts (NEVER ship to mobile)
# -----------------------------------------------------------------------------

# Supabase project URL. Find at: app.supabase.com → Project → Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase service-role key. Bypasses RLS — use ONLY in Edge Functions and
# server-side ingest/smoke scripts. Never put it in either browser app or the
# mobile app; the browser admin console uses the anon key and protected admin
# Edge Functions instead.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase anon (publishable) key. Safe to expose to clients but kept here too
# so backend scripts can act as a normal user when needed for testing RLS.
SUPABASE_ANON_KEY=

# Anthropic Claude API key. Optional low-cost fallback for the main answer call.
ANTHROPIC_API_KEY=

# DeepSeek API key. Default answer model provider for v1 because it is a
# low-cost OpenAI-compatible Chinese model. Keep all provider keys backend-only.
DEEPSEEK_API_KEY=

# Optional: generic OpenAI-compatible chat-completions provider. Use this for
# OpenAI, hosted open-weight models, or other compatible gateways.
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1

# OpenAI API key. Used for embeddings (`text-embedding-3-small`, 1536 dim).
# If you switch the embedding model later, the entire corpus must be re-embedded
# — that is an expensive operation and should be approved explicitly.
OPENAI_API_KEY=

# Optional: Google Gemini API key. Only needed if you swap the LLM or embedding
# provider during evaluation.
# GOOGLE_API_KEY=

# Default LLM model identifier used by the RAG pipeline for the main answer call.
# v1 default is the cheap non-thinking DeepSeek model. Alternatives:
#   LLM_PROVIDER=openai-compatible + LLM_DEFAULT_MODEL=gpt-4.1-mini
#   LLM_PROVIDER=anthropic + LLM_DEFAULT_MODEL=claude-haiku-4-5
LLM_PROVIDER=deepseek
LLM_DEFAULT_MODEL=deepseek-v4-flash
LLM_MAX_OUTPUT_TOKENS=1200

# RAG runtime controls. Keep these conservative until the eval set proves that
# larger prompts materially improve answer quality. RAG_MATCH_COUNT is capped at
# 20 to match cached/message audit constraints.
RAG_MATCH_COUNT=8
RAG_MIN_SIMILARITY=0
RAG_KEYWORD_WEIGHT=0.15
RAG_MAX_CONTEXT_CHARS=12000
RAG_MAX_QUESTION_CHARS=2000
RAG_FETCH_TIMEOUT_MS=30000

# Optional estimated model pricing used only for `messages.cost_usd` audit logs.
# Set these in Supabase Edge Function env to match your actual provider contract.
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0
EMBEDDING_INPUT_COST_PER_MILLION=0
# Keep disabled until the three provider pricing values below are configured
# with current rates; the backend rejects a positive budget with zero pricing.
LLM_MONTHLY_BUDGET_USD=0
AI_RATE_LIMIT_PER_MINUTE=20

# Monthly LLM spend alerts should also be configured in provider consoles. When
# `LLM_MONTHLY_BUDGET_USD` is positive, all three pricing values above must be
# set to current non-zero provider rates so the Edge Function can reserve and
# enforce the project-wide cap; set the budget to `0` to disable the backend cap.

# Free-tier daily AI message cap. 5–10 is the recommended range; ship with 5.
FREE_DAILY_LIMIT=5

# Embedding model identifier. Changing this requires re-embedding the corpus.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Optional: Sentry DSN for the backend (Edge Functions / Node scripts). The
# mobile app uses its own DSN below.
# SENTRY_DSN_BACKEND=
# Optional: PostHog server-side key and host for redacted backend error events.
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://app.posthog.com

# Node env. Set to `development` locally, `production` in deployed Edge Functions.
NODE_ENV=development


# -----------------------------------------------------------------------------
# Mobile app — EXPO_PUBLIC_* (bundled into app, visible to users)
# -----------------------------------------------------------------------------

# Supabase project URL for the mobile client. Same value as SUPABASE_URL above
# — duplicated because Expo only exposes `EXPO_PUBLIC_*` vars to the app bundle.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase anon (publishable) key for the mobile client. Safe to ship; RLS is
# what protects user data, not key secrecy.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# EAS project ID used to obtain Expo push tokens in native builds.
EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=

# RevenueCat public SDK keys (one per platform). Get from RevenueCat dashboard →
# Apps → API keys. These are the "public" keys, safe in the app bundle. The
# RevenueCat *secret* key (used by the webhook handler) lives server-side only.
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=

# PostHog project key (write key). Public by design.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Sentry DSN for the mobile app. Public by design.
EXPO_PUBLIC_SENTRY_DSN=

# Launch profile and feature gate. The pilot is core-only; keep payments off
# until the finite challenge has its separate commercial and content approval.
EXPO_PUBLIC_LAUNCH_PROFILE=core
EXPO_PUBLIC_AI_READY=false
EXPO_PUBLIC_PAYMENTS_ENABLED=false


# -----------------------------------------------------------------------------
# Server-side-only secrets for Edge Functions, schedulers, and live smoke tests.
# Never expose these through EXPO_PUBLIC_* variables or the mobile bundle.
# -----------------------------------------------------------------------------

# Expo Access Token — used by the push-notifications scheduled function and
# optionally by EAS Build / Submit automation.
# EXPO_ACCESS_TOKEN=

# Backend Edge Function secrets.
# DAILY_REFLECTIONS_CRON_SECRET authenticates the scheduled sender.
# RevenueCat webhook signatures are verified against the raw request body.
# DAILY_REFLECTIONS_CRON_SECRET=
# REVENUECAT_WEBHOOK_SECRET=
# REVENUECAT_API_KEY=  # Secret API key for TRANSFER subscriber reconciliation.
# REVENUECAT_WEBHOOK_TOLERANCE_SECONDS=300
# REVENUECAT_ALLOW_SANDBOX=false
# Isolated sandbox webhook replay (never point this at a production project).
# REVENUECAT_WEBHOOK_URL=https://YOUR_SANDBOX_PROJECT_REF.supabase.co/functions/v1/revenuecat-webhook
# REVENUECAT_SMOKE_USER_ID=
# Disposable second account used to verify TRANSFER source revocation.
# REVENUECAT_SMOKE_TRANSFER_DESTINATION_USER_ID=
# REVENUECAT_SMOKE_PRODUCT_ID=plus_monthly
# REVENUECAT_SMOKE_CONFIRM=REVENUECAT_SANDBOX_LIVE

# Optional non-destructive two-user RLS smoke test credentials. Use disposable
# confirmed test accounts only; never commit values.
# RLS_SMOKE_EMAIL_A=
# RLS_SMOKE_PASSWORD_A=
# RLS_SMOKE_EMAIL_B=
# RLS_SMOKE_PASSWORD_B=

# Destructive account export/deletion smoke test. Use a disposable confirmed
# account and set the explicit confirmation value only for the test run.
# ACCOUNT_DELETE_SMOKE_EMAIL=
# ACCOUNT_DELETE_SMOKE_PASSWORD=
# ACCOUNT_DELETE_SMOKE_CONFIRM=DELETE_ACCOUNT_LIVE
# ACCOUNT_FUNCTION_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/account

# Optional disposable authenticated user for the live RAG smoke runner. This
# exercises safety short-circuiting, a cited uncached answer, and a cache hit.
# RAG_SMOKE_EMAIL=
# RAG_SMOKE_PASSWORD=
# RAG_ASK_FUNCTION_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/ask
# RAG_SMOKE_TRADITION=general
# RAG_SMOKE_QUESTION=What does the Bhagavad Gita teach about acting without attachment?

# Optional guarded notification worker smoke. Use a disposable confirmed user
# and a test-device Expo token; the runner temporarily changes only that
# profile's reminder time, then restores it and removes the test rows.
# NOTIFICATION_SMOKE_USER_ID=
# NOTIFICATION_SMOKE_EXPO_PUSH_TOKEN=ExponentPushToken[...]
# NOTIFICATION_SMOKE_CONFIRM=NOTIFICATION_LIVE
