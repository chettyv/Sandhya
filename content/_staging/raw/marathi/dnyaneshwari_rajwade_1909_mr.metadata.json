u093e\u0925 \u0930\u093e\u091c\u0935\u093e\u0921\u0947 \u0939\u094d\u092f\u093e\u0902\u0928\u093e \u092c\u0940\u0921 \u092f\u0947\u0925\u0940\u0932 \u092a\u093e\u091f\u0902\u0917\u0923\u091a\u094d\u092f\u093e \u092e\u0920\u093e\u0924 \u091c\u094d\u091e\u093e\u0928\u0947\u0936\u094d\u0935\u0930\u0940\u091a\u0947 \u090f\u0915 \u0939\u0938\u094d\u0924\u0932\u093f\u0916\u093f\u0924 \u0909\u092a\u0932\u092c\u094d\u0927 \u091d\u093e\u0932\u0947 \u0939\u094b\u0924\u0947. \u0924\u0947 \u0924\u094d\u092f\u093e\u0902\u0928\u0940 \u0938\u0902\u092a\u093e\u0926\u093f\u0924 \u0915\u0930\u0942\u0928 \u0936\u0915\u0947 \u0967\u096e\u0969\u0967 (\u0907. \u0938. \u0967\u096f\u0966\u096f)\u092e\u0927\u094d\u092f\u0947 \u0938\u0924\u094d\u0915\u093e\u0930\u094d\u092f\u094b\u0924\u094d\u0924\u0947\u091c\u0915 \u0938\u092d\u093e, \u0927\u0941\u0933\u0947 \u0939\u094d\u092f\u093e\u0902\u091a\u094d\u092f\u093e \u0926\u094d\u0935\u093e\u0930\u0947 \u092a\u094d\u0930\u0915\u093e\u0936\u093f\u0924 \u0915\u0947\u0932\u0947. \u0939\u0940 \u092e\u0941\u0926\u094d\u0930\u093e\u0935\u0943\u0924\u094d\u0924\u0940 \u0930\u093e\u091c\u0935\u093e\u0921\u0947\u092a\u094d\u0930\u0924 \u092e\u094d\u0939\u0923\u0942\u0928 \u0913\u0933\u0916\u0923\u094d\u092f\u093e\u0924 \u092f\u0947\u0924\u0947. \u0939\u0940 \u092a\u094d\u0930\u0924 \u091c\u094d\u091e\u093e\u0928\u0947\u0936\u094d\u0935\u0930\u0940\u091a\u094d\u092f\u093e \u0905\u092d\u094d\u092f\u093e\u0938\u093e\u0924 \u090f\u0915 \u092e\u0939\u0924\u094d\u0924\u094d\u0935\u093e\u091a\u0940 \u092a\u094d\u0930\u0924 \u092e\u093e\u0928\u0923\u094d\u092f\u093e\u0924 \u092f\u0947\u0924\u0947. <br /></div><div><br /></div><div>\u0930\u093e\u091c\u0935\u093e\u0921\u0947\u092a\u094d\u0930\u0924\u0940\u091a\u0940 \u090f\u0915 \u092e\u0941\u0926\u094d\u0930\u093e\u092a\u094d\u0930\u0924 \u091a\u093f\u0924\u094d\u0930\u092a\u091f-\u0905\u092d\u094d\u092f\u093e\u0938\u0915, \u0932\u0947\u0916\u0915 \u0906\u0923\u093f \u0926\u093f\u0917\u094d\u0926\u0930\u094d\u0936\u0915 \u0936\u094d\u0930\u0940. \u0905\u0930\u0941\u0923 \u0916\u094b\u092a\u0915\u0930 \u0939\u094d\u092f\u093e\u0902\u091a\u094d\u092f\u093e \u0938\u0902\u0917\u094d\u0930\u0939\u093e\u0924 \u0906\u0922\u0933\u0932\u0940. \u0924\u094d\u092f\u093e\u0935\u0930 \u0938\u0902\u0936\u094b\u0927\u0915 \u0936\u094d\u0930\u0940. \u0928. \u0930. \u092b\u093e\u091f\u0915 (\u0936\u094d\u0930\u0940. \u0928\u0930\u0939\u0930 \u0930\u0918\u0941\u0928\u093e\u0925 \u092b\u093e\u091f\u0915) \u0939\u094d\u092f\u093e\u0902\u091a\u0947 \u0928\u093e\u0935 \u0905\u0938\u0942\u0928 \u0924\u094d\u092f\u093e\u0902\u091a\u094d\u092f\u093e\u091a \u0939\u0938\u094d\u0924\u093e\u0915\u094d\u0937\u0930\u093e\u0924 \u0905\u0928\u094d\u092f \u092a\u093e\u0920\u093e\u0902\u091a\u0940 \u0928\u094b\u0902\u0926 \u0915\u0947\u0932\u0947\u0932\u0940 \u0906\u0922\u0933\u0924\u0947. \u0924\u094d\u092f\u093e \u092a\u094d\u0930\u0924\u0940\u091a\u094d\u092f\u093e \u0938\u0902\u0917\u0923\u0915\u0940\u092f \u092a\u094d\u0930\u0924\u093f\u092e\u093e\u0902\u091a\u0940 \u0939\u0940 \u092a\u094d\u0930\u0924 \u0907\u0925\u0947 \u0905\u092d\u094d\u092f\u093e\u0938\u0915\u093e\u0902\u0938\u093e\u0920\u0940 \u0909\u092a\u0932\u092c\u094d\u0927 \u0915\u0930\u0942\u0928 \u0926\u0947\u0923\u094d\u092f\u093e\u0924 \u092f\u0947\u0924 \u0906\u0939\u0947.<br /></div>","language":"mar","licenseurl":"http://creativecommons.org/publicdomain/mark/1.0/","scanner":"Internet Archive HTML5 Uploader 1.6.4","subject":["\u091c\u094d\u091e\u093e\u0928\u0947\u0936\u094d\u0935\u0930\u0940","\u091c\u094d\u091e\u093e\u0928\u0926\u0947\u0935\u0940","\u0930\u093e\u091c\u0935\u093e\u0921\u0947\u092a\u094d\u0930\u0924","\u0930\u093e\u091c\u0935\u093e\u0921\u0947","Dnyaneshwari","Rajwade","Rajawade","Rajavade","Marathi","\u092e\u0930\u093e\u0920\u0940","\u0938\u0924\u094d\u0915\u093e\u0930\u094d\u092f\u094b\u0924\u094d\u0924\u0947\u091c\u0915 \u0938\u092d\u093e"],"title":"\u091c\u094d\u091e\u093e\u0928\u0947\u0936\u094d\u0935\u0930\u0940 (