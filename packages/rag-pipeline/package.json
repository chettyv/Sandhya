{
  "name": "@sandhya/rag-pipeline",
  "version": "0.0.0",
  "private": true,
  "description": "RAG pipeline: classifier, safety gate, vector search, structured-output LLM call, caching. CLI + library.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "rag": "./dist/cli.js",
    "rag-audit-prepared": "./dist/audit-prepared.js",
    "rag-prepare-corpus": "./dist/prepare-corpus.js",
    "rag-ingest-prepared": "./dist/ingest-prepared.js",
    "rag-evaluate": "./dist/evaluate.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@sandhya/shared-types": "workspace:*",
    "js-tiktoken": "^1.0.21"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
