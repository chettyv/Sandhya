# Cloudflare Pages / Netlify rewrites for Expo Router dynamic routes.
# Expo's static export copies public/ into the web build root, so deep links
# to dynamic screens resolve to their exported HTML instead of 404.
/challenge/*/night/*  /challenge/[slug]/night/[night].html  200
/challenge/*  /challenge/[slug].html  200
/shloka/*  /shloka/[slug].html  200
/reflection/*  /reflection/[id].html  200
/festival/*  /festival/[id].html  200
/practice/*  /practice/[id].html  200
/concept/*  /concept/[id].html  200
/deity/*  /deity/[id].html  200
/text/*  /text/[id].html  200
/conversation/*  /conversation/[id].html  200
