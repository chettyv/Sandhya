{
  "name": "@sandhya/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Sandhya mobile app for iOS and Android.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "vitest run --pool=threads --maxWorkers=1 --minWorkers=1"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.0",
    "@supabase/supabase-js": "^2.90.1",
    "@tanstack/react-query": "^5.90.19",
    "expo": "~56.0.16",
    "expo-blur": "~56.0.3",
    "expo-constants": "~56.0.21",
    "expo-dev-client": "~56.0.24",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-linear-gradient": "~56.0.3",
    "expo-linking": "~56.0.15",
    "expo-notifications": "~56.0.22",
    "expo-router": "~56.2.15",
    "expo-secure-store": "~56.0.3",
    "expo-splash-screen": "~56.0.13",
    "expo-status-bar": "~56.0.4",
    "expo-web-browser": "~56.0.5",
    "nativewind": "^4.2.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
