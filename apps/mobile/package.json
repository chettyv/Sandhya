    "react-native-worklets": "0.8.3",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~56.0.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3",
    "vitest": "^2.1.8"
