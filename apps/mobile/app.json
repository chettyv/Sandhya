{
  "expo": {
    "name": "Sandhya",
    "slug": "sandhya",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/sandhya-icon.png",
    "scheme": "sandhya",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.sandhya.mobile",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/sandhya-icon.png",
        "backgroundColor": "#26172B"
      },
      "predictiveBackGestureEnabled": true,
      "package": "app.sandhya.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/sandhya-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/sandhya-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#26172B",
          "dark": {
            "backgroundColor": "#170F1B"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
