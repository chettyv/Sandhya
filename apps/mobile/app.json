{
  "expo": {
    "name": "Sandhya",
    "slug": "sandhya",
    "owner": "chettyvs-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/sandhya-icon.png",
    "scheme": "sandhya",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.sandhya.mobile",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/sandhya-icon.png",
        "backgroundColor": "#D97824"
      },
      "predictiveBackGestureEnabled": true,
      "package": "app.sandhya.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/sandhya-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/sandhya-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FCF8EF",
          "dark": {
            "backgroundColor": "#F4E9DA"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "9f09c3de-e627-4973-bc30-3b3ac2653b5c"
      }
    }
  }
}
