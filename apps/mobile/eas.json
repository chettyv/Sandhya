{
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_LAUNCH_PROFILE": "core",
        "EXPO_PUBLIC_AI_READY": "false",
        "EXPO_PUBLIC_PAYMENTS_ENABLED": "false"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_LAUNCH_PROFILE": "core",
        "EXPO_PUBLIC_AI_READY": "false",
        "EXPO_PUBLIC_PAYMENTS_ENABLED": "false"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_LAUNCH_PROFILE": "core",
        "EXPO_PUBLIC_AI_READY": "false",
        "EXPO_PUBLIC_PAYMENTS_ENABLED": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
