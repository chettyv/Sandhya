{
  "name": "sandhya",
  "version": "0.0.0",
  "private": true,
  "description": "Sandhya — an AI companion for Hindu learning and daily practice. Monorepo root.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0 <23",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" --filter \"./apps/*\" run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:check:changed": "node scripts/format-changed.mjs",
    "test": "pnpm -r run test",
    "backend:check": "node scripts/verify-backend.mjs",
    "backend:source-check": "node scripts/verify-backend.mjs --source-only",
    "backend:release-contract": "node scripts/verify-release-contract.mjs",
    "backend:curated-content-check": "node --experimental-transform-types scripts/generate-authored-catalog-migration.mjs --check",
    "backend:migration-check": "node scripts/verify-migration-security.mjs",
    "backend:account-check": "node scripts/verify-account-flow.mjs",
    "backend:billing-check": "node --experimental-transform-types scripts/verify-revenuecat-transfer.mjs",
    "backend:notifications-check": "node --experimental-transform-types scripts/verify-notification-worker.mjs",
    "backend:notifications-smoke:live": "node scripts/notification-live-smoke.mjs",
    "backend:scheduler-check": "node scripts/verify-scheduler-contract.mjs",
    "backend:push-token-check": "node --experimental-transform-types scripts/verify-push-token-flow.mjs",
    "backend:schema-check": "node scripts/verify-database-contract.mjs",
    "verify:technical-launch": "node scripts/verify-technical-launch.mjs",
    "backend:smoke:live": "node scripts/account-live-smoke.mjs",
    "backend:account-delete-smoke:live": "node scripts/account-delete-live-smoke.mjs",
    "backend:billing-smoke:live": "node scripts/revenuecat-sandbox-live-smoke.mjs",
    "workspace:lock-check": "node scripts/verify-workspace-lock.mjs",
    "rag:doctor": "node scripts/rag-doctor.mjs",
    "rag": "node scripts/rag-cli.mjs",
    "content": "node scripts/content-cli.mjs",
    "content:validate": "pnpm --filter @sandhya/content-tools build && node scripts/content-cli.mjs validate content",
    "content:stats": "pnpm --filter @sandhya/content-tools build && node scripts/content-cli.mjs stats content",
    "content:generate-authored-migration": "node --experimental-transform-types scripts/generate-authored-catalog-migration.mjs",
    "content:ingest": "pnpm rag:prepare && pnpm rag:audit && pnpm rag:ingest",
    "content:ingest:canonical": "pnpm rag:prepare:canonical && pnpm rag:audit:canonical && pnpm rag:ingest:canonical",
    "content:reembed": "pnpm rag:prepare && pnpm rag:audit && pnpm rag:ingest -- --force-reembed",
    "rag:smoke:live": "node scripts/rag-live-smoke.mjs",
    "rag:prepare": "pnpm --filter @sandhya/rag-pipeline build && node packages/rag-pipeline/dist/prepare-corpus.js content/_staging/raw content/_staging/prepared/rag-corpus.jsonl",
    "rag:prepare:canonical": "pnpm --filter @sandhya/rag-pipeline build && node packages/rag-pipeline/dist/prepare-corpus.js content/original content/_staging/prepared/rag-corpus-canonical.jsonl",
    "rag:audit": "node packages/rag-pipeline/dist/audit-prepared.js content/_staging/prepared/rag-corpus.jsonl",
    "rag:audit:canonical": "node packages/rag-pipeline/dist/audit-prepared.js content/_staging/prepared/rag-corpus-canonical.jsonl",
    "rag:ingest": "pnpm --filter @sandhya/rag-pipeline build && node packages/rag-pipeline/dist/ingest-prepared.js content/_staging/prepared/rag-corpus.jsonl",
    "rag:ingest:canonical": "pnpm --filter @sandhya/rag-pipeline build && node packages/rag-pipeline/dist/ingest-prepared.js content/_staging/prepared/rag-corpus-canonical.jsonl",
    "rag:ingest:dry-run": "pnpm --filter @sandhya/rag-pipeline build && node packages/rag-pipeline/dist/ingest-prepared.js content/_staging/prepared/rag-corpus.jsonl --dry-run --allow-staging",
    "rag:ingest:canonical:dry-run": "pnpm --filter @sandhya/rag-pipeline build && node packages/rag-pipeline/dist/ingest-prepared.js content/_staging/prepared/rag-corpus-canonical.jsonl --dry-run",
    "rag:evaluate:validate": "pnpm --filter @sandhya/rag-pipeline build && node packages/rag-pipeline/dist/evaluate.js --validate-only content/_staging/evals/rag-eval.example.jsonl",
    "rag:evaluate": "pnpm --filter @sandhya/rag-pipeline build && node packages/rag-pipeline/dist/evaluate.js content/_staging/evals/rag-eval.example.jsonl",
    "secrets:scan": "secretlint \"**/*\" --secretlintignore .gitignore",
    "prepare": "husky",
    "content:generate-challenge-seed": "pnpm --filter @sandhya/content-tools build && node scripts/generate-challenge-seed.mjs",
    "content:generate-shloka-bank": "pnpm --filter @sandhya/content-tools build && node scripts/generate-shloka-bank.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.39.4",
    "@secretlint/secretlint-rule-pattern": "^13.0.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "secretlint": "^13.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  },
  "lint-staged": {
    "*": [
      "secretlint --secretlintignore .gitignore"
    ],
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
